[gd_resource type="Resource" script_class="BuildingCatalog" format=3]

[ext_resource type="Script" path="res://data/building_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://data/building_def.gd" id="2_def"]
[ext_resource type="Resource" path="res://data/buildings/placeholder_house.tres" id="3_house"]
[ext_resource type="Resource" path="res://data/buildings/placeholder_workshop.tres" id="4_workshop"]
[ext_resource type="Resource" path="res://data/buildings/placeholder_factory.tres" id="5_factory"]

[resource]
script = ExtResource("1_catalog")
buildings = Array[ExtResource("2_def")]([ExtResource("3_house"), ExtResource("4_workshop"), ExtResource("5_factory")])

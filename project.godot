; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Society"
config/description="City builder de economia e logística no século XIX."
config/version="0.17.0"
config/icon="res://assets/icon/society_256.png"
config/windows_native_icon="res://assets/icon/society.ico"
run/main_scene="res://ui/screens/boot_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://core/event_bus.gd"
Settings="*res://core/settings.gd"
GameClock="*res://core/game_clock.gd"
SaveSystem="*res://core/save_system.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/SunshineClouds2/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[gui]

theme/custom="res://ui/theme/society_theme.tres"
theme/custom_font="res://assets/fonts/OldStandard-Regular.ttf"

[internationalization]

locale/translations=PackedStringArray("res://ui/translations/strings.pt_BR.translation", "res://ui/translations/strings.en.translation")
locale/translations_pot_files=PackedStringArray("res://ui/advisor/advisor.dialogue")
locale/fallback="pt_BR"

[rendering]

renderer/rendering_method="forward_plus"
occlusion_culling/use_occlusion_culling=true
textures/canvas_textures/default_texture_filter=3

[shader_globals]

visual_time={
"type": "float",
"value": 0.0
}
night_light={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}

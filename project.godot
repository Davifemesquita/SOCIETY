; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Society"
config/description="City builder de economia e logística no século XIX."
config/version="0.1.0"
run/main_scene="res://ui/screens/boot_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://core/event_bus.gd"
Settings="*res://core/settings.gd"
GameClock="*res://core/game_clock.gd"
SaveSystem="*res://core/save_system.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://ui/translations/strings.pt_BR.translation", "res://ui/translations/strings.en.translation")
locale/fallback="pt_BR"

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

visual_time={
"type": "float",
"value": 0.0
}
night_light={
"type": "float",
"value": 0.0
}
